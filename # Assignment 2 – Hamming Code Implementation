#include <iostream>
#include <string>
using namespace std;

int main() {
    string dataBits;

    cout << "Enter 4 bit binary data: ";
    cin >> dataBits;

    if (dataBits.size() != 4) {
        cout << "Invalid input. Enter exactly 4 bits." << endl;
        return 0;
    }

    for (char bit : dataBits) {
        if (bit != '0' && bit != '1') {
            cout << "Invalid input. Only 0 and 1 are allowed." << endl;
            return 0;
        }
    }

    int m = 4, r = 0;

    while ((1 << r) < m + r + 1)
        r++;

    cout << "Data Bits:" << dataBits << endl;
    cout << "Number of Parity bits:" << r << endl;

    char code[8];

    code[1] = 'P';
    code[2] = 'P';
    code[4] = 'P';

    code[3] = dataBits[3];
    code[5] = dataBits[2];
    code[6] = dataBits[1];
    code[7] = dataBits[0];

    cout << "\nHamming code positions:" << endl;

    for (int pos = 1; pos <= 7; pos++)
        cout << "Position " << pos << ": " << code[pos] << endl;

    int p = 1;

    while (p <= 4) {
        int result = 0;

        cout << "P" << p << " checks positions: ";

        for (int pos = 1; pos <= 7; pos++) {
            if ((pos & p) == p) {
                cout << pos << " ";

                if (pos != p)
                    result ^= code[pos] - '0';
            }
        }

        code[p] = result + '0';

        cout << "-> P" << p << " = " << code[p] << endl;

        p *= 2;
    }

    cout << "\nParity Bits:" << endl;
    cout << "P1 = " << code[1] << endl;
    cout << "P2 = " << code[2] << endl;
    cout << "P3 = " << code[4] << endl;

    cout << "\nFinal Hamming Code: ";

    for (int pos = 1; pos <= 7; pos++)
        cout << code[pos];

    cout << endl;

    return 0;
}
